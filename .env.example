# Only needed for "Start live", the setup and propose commands, and the AI judge.
# "Start" on the demo screen replays a recorded run and needs nothing.
ANTHROPIC_API_KEY=

# Optional: trace every live run in PostHog (LLM analytics). Off unless set to "on".
# Traces carry structure only (steps, rules, verdicts, tokens, cost, latency).
SHIFTGUARD_TELEMETRY=off
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Also send prompts, replies, rule messages and names. Off unless set to "on".
# SHIFTGUARD_TELEMETRY_CONTENT=off

# Optional
# PORT=4321
# SHIFTGUARD_DB=runs/shiftguard.db
# CHROME_PATH=/usr/bin/google-chrome
