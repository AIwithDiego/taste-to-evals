# Only needed for "Start live", the setup and propose commands, and the AI judge.
# "Start" on the demo screen replays a recorded run and needs nothing.
ANTHROPIC_API_KEY=

# Optional: trace every live run in PostHog (LLM analytics). Off unless set to "on".
# Traces include full prompts and replies.
SHIFTGUARD_TELEMETRY=off
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Optional
# PORT=4321
# SHIFTGUARD_DB=runs/shiftguard.db
# CHROME_PATH=/usr/bin/google-chrome
